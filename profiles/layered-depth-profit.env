# =========================================================
# LAYERED DEPTH - PROFIT-FOCUSED MARKET MAKING PROFILE
# =========================================================
# Strategy: Idea 2 - layered buy/sell depth for spread capture.
# - 4 orders per side spread across current market range.
# - Buys at 7.4e-11 to 7.8e-11, sells at 9.2e-11 to 1.07e-10.
# - Captures ~18-19% spread per matched pair.
# - Hard reserve keeps $620+ USDT safe; only ~$80-100 deployed.
# - Adverse-fill ratio relaxed so layered buys aren't suppressed.
# =========================================================

# --- Core mode ---
FORCE_BUY_PAUSE=false
BUY_REACTIVATION_MODE=auto
DEX_PRICE_DISCOUNT_PERCENT=26
SELF_TRADE_ENABLED=false
SELF_TRADE_MODE=off

# --- ETH/USD source ---
ETH_USD_SOURCE=chainlink
ETH_USD_CHAINLINK_FEED_ADDRESS=0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70
ETH_USD_FALLBACK=2200
ETH_USD_CACHE_MS=120000
COINGECKO_ETH_USD_URL=https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd

# --- Spread / drift guardrails ---
MAX_DEX_CEX_DRIFT_PERCENT=75
MAX_EXEC_SPREAD_PERCENT=600
MAX_EXECUTABLE_SPREAD_CIRCUIT_BREAKER_PERCENT=200
MIN_EXEC_DEPTH_BUY_USD=0
MIN_EXEC_DEPTH_SELL_USD=0
MIN_NET_EDGE_BPS=5

# Relaxed so layered buys are not suppressed after first fill.
ADVERSE_FILL_RATIO_MAX=5.0

# --- USDT budget control ---
# Reserve $620; deploy ~$80-100 actively across 4 layers per side.
IDLE_BALANCE_RESERVE_USD=620

# --- Order depth: 4 layers per side, ~$20-25 each ---
TARGET_ORDERS_PER_SIDE=4
TARGET_BUY_DEPTH_USD=24
TARGET_SELL_DEPTH_USD=24
MAX_ORDER_AMOUNT_TOKENS=50000000000

# --- Pacing: faster cycles to re-price into dips ---
ORDER_FREQUENCY=7000
QUOTE_CHURN_REFRESH_PER_SIDE=1

# --- Spread band: wider to create price layers across the book ---
PASSIVE_BUY_BAND_OUTER_OFFSET_PERCENT=0.020
PASSIVE_BUY_BAND_INNER_OFFSET_PERCENT=0.002
PASSIVE_SELL_BAND_INNER_OFFSET_PERCENT=0.002
PASSIVE_SELL_BAND_OUTER_OFFSET_PERCENT=0.020
PASSIVE_SEED_BASE_OFFSET_PERCENT=0.004
PASSIVE_SEED_STEP_OFFSET_PERCENT=0.004
TOP_TOUCH_IMPROVEMENT_SPREAD_FRACTION=0.50

# Sell near bid to increase chance of sell fills at current market.
SELL_NEAR_BID_ENABLED=true
SELL_NEAR_BID_TICKS=1
SELL_NEAR_BID_MIN_MARKUP_BPS=2

# --- Inventory limits: 200B max prevents over-accumulation ---
INVENTORY_SKEW_MAX_PERCENT=0.002
INVENTORY_SKEW_ACTIVATION_RATIO=0.08
MAX_POSITION_SIZE=200000000000
POSITION_REBALANCE_THRESHOLD=150000000000

# Clean start so new price layers take effect immediately.
CANCEL_ORDERS_ON_START=true
CANCEL_ORDERS_ON_STOP=false

# --- Wash trading fully disabled ---
IDLE_WASH_ENABLE_AFTER_MS=31536000000
IDLE_WASH_COOLDOWN_AFTER_REAL_FILL_MS=31536000000
IDLE_WASH_MAX_PAIRS_PER_CYCLE=0
IDLE_WASH_REQUIRE_LOW_DRIFT=true
IDLE_WASH_MAX_DRIFT_PERCENT=3
IDLE_WASH_MAX_EXEC_SPREAD_PERCENT=8
PAUSE_WASH_ON_HIGH_DRIFT=true
WASH_RESERVED_PLACEMENTS_PER_CYCLE=0
WASH_ORDER_SIZE_CAP_USD=0
WASH_USDT_SCALE_THRESHOLD=999999
WASH_BASE_PAIRS_PER_CYCLE=0
WASH_MAX_PAIRS_PER_CYCLE=0
IDLE_WASH_SAME_PRICE_UPWARD_STEP_BPS_PER_MINUTE=0
IDLE_WASH_SAME_PRICE_UPWARD_MAX_BPS=0
IDLE_WASH_PROTECT_EXTERNAL_BUYS=true
IDLE_WASH_PROTECT_MIN_SPREAD_TICKS=30
