# =========================================================
# IDLE WASH - SAME PRICE UPTREND (Volume Only)
# =========================================================
# - Wash is enabled in SELF_TRADE_MODE=auto with real-fill cooldown.
# - Wash reference drifts upward while no real fills are detected.
# - Protected same-price mode keeps wash price inside spread and places
#   SELL first, then BUY, to reduce accidental external buy-side fills.
# =========================================================

BUY_REACTIVATION_MODE=auto
SELF_TRADE_ENABLED=true
SELF_TRADE_MODE=auto
MAX_DEX_CEX_DRIFT_PERCENT=8
IDLE_BALANCE_RESERVE_USD=300.0
MAX_EXEC_SPREAD_PERCENT=6
MIN_EXEC_DEPTH_BUY_USD=5
MIN_EXEC_DEPTH_SELL_USD=5
MIN_NET_EDGE_BPS=0
TARGET_ORDERS_PER_SIDE=1
TARGET_BUY_DEPTH_USD=0
TARGET_SELL_DEPTH_USD=0
ORDER_FREQUENCY=20000

# Tight idle gates for safer operation.
IDLE_WASH_ENABLE_AFTER_MS=120000
IDLE_WASH_COOLDOWN_AFTER_REAL_FILL_MS=600000
IDLE_WASH_MAX_PAIRS_PER_CYCLE=1
WASH_ORDER_SIZE_CAP_USD=5.05
IDLE_WASH_REQUIRE_LOW_DRIFT=true
IDLE_WASH_MAX_DRIFT_PERCENT=2.5
IDLE_WASH_MAX_EXEC_SPREAD_PERCENT=4
PAUSE_WASH_ON_HIGH_DRIFT=true

# Upward trend while idle (no real fills).
IDLE_WASH_SAME_PRICE_UPWARD_STEP_BPS_PER_MINUTE=0.5
IDLE_WASH_SAME_PRICE_UPWARD_MAX_BPS=8

# Prevent wash buys from crossing external asks when possible.
IDLE_WASH_PROTECT_EXTERNAL_BUYS=true
IDLE_WASH_PROTECT_MIN_SPREAD_TICKS=5
