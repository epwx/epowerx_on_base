# =========================================================
# IDLE WASH - SAME PRICE (Volume Only, No Loss)
# =========================================================
# Auto buys (for wash trading to work), enables wash at SAME price
# Wash trading: buy at price X, sell at price X = zero cost volume
# Activates after 1 minute of no real fills
# Stops immediately when real user order fills
# Relaxed drift gate to allow buys for wash trades
# =========================================================

BUY_REACTIVATION_MODE=on
SELF_TRADE_MODE=on
MAX_DEX_CEX_DRIFT_PERCENT=35
IDLE_BALANCE_RESERVE_USD=319.8
MAX_EXEC_SPREAD_PERCENT=999
MIN_EXEC_DEPTH_BUY_USD=0
MIN_EXEC_DEPTH_SELL_USD=0
MIN_NET_EDGE_BPS=0
TARGET_ORDERS_PER_SIDE=1
TARGET_BUY_DEPTH_USD=0
TARGET_SELL_DEPTH_USD=0
ORDER_FREQUENCY=20000

# Remove drift/spread guards - allow wash at same price regardless of market conditions
IDLE_WASH_ENABLE_AFTER_MS=0
IDLE_WASH_COOLDOWN_AFTER_REAL_FILL_MS=0
IDLE_WASH_MAX_PAIRS_PER_CYCLE=1
WASH_ORDER_SIZE_CAP_USD=5.05
IDLE_WASH_REQUIRE_LOW_DRIFT=false
IDLE_WASH_MAX_DRIFT_PERCENT=999
IDLE_WASH_MAX_EXEC_SPREAD_PERCENT=999
PAUSE_WASH_ON_HIGH_DRIFT=false
