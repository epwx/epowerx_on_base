MIN_EXEC_DEPTH_SELL_USD=0.5
MIN_NET_EDGE_BPS=100
ADVERSE_FILL_RATIO_MAX=1.05
ADVERSE_FILL_INVENTORY_LIMIT_USD=10
RISK_SIZE_MULTIPLIER_DEFENSIVE=0.20
RISK_SIZE_MULTIPLIER_NORMAL=0.25
MAX_DEX_CEX_DRIFT_PERCENT=5
LATEST_PRICE_BAND_HALF_WIDTH_PERCENT=1000
REBALANCE_MAX_SPREAD_PERCENT=8
REBALANCE_MAX_PRICE_DEVIATION_PERCENT=5

INVENTORY_SKEW_MAX_PERCENT=0.0005
INVENTORY_SKEW_ACTIVATION_RATIO=0.02
MAX_POSITION_SIZE=60000000000
POSITION_REBALANCE_THRESHOLD=30000000000
PASSIVE_BUY_BAND_OUTER_OFFSET_PERCENT=0.75
PASSIVE_BUY_BAND_INNER_OFFSET_PERCENT=0.15
PASSIVE_SELL_BAND_INNER_OFFSET_PERCENT=0.15
PASSIVE_SELL_BAND_OUTER_OFFSET_PERCENT=0.75
PASSIVE_SEED_BASE_OFFSET_PERCENT=0.15
