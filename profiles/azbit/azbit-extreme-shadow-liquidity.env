# Manual-only Azbit extreme-dislocation experiment. This profile simulates a
# sparse two-sided ladder but can never submit it to the exchange.
EXCHANGE_NAME=azbit
TRADING_PAIR=EPWX_USDT
EPWX_TOKEN_ADDRESS=0xeF5f5751cf3eCA6cC3572768298B7783d33D60Eb
EPWX_WETH_PAIR=0x9793d47dd47024ac4e1f17988d2e92da53a94541
AZBIT_READ_ONLY=true
AZBIT_SHADOW_MODE=true

FORCE_BUY_PAUSE=false
BUY_REACTIVATION_MODE=on
SELF_TRADE_ENABLED=false
SELF_TRADE_MODE=off

MIN_ORDER_SIZE=5.26
MAX_ORDER_SIZE=5.50
MAX_ORDER_AMOUNT_TOKENS=45000000000
TARGET_ORDERS_PER_SIDE=5
TARGET_BUY_DEPTH_USD=27.50
TARGET_SELL_DEPTH_USD=27.50
ORDER_FREQUENCY=30000
QUOTE_CHURN_REFRESH_PER_SIDE=0
BALANCE_UTILIZATION_PERCENT=0.054
IDLE_BALANCE_RESERVE_USD=20

MAX_EXEC_SPREAD_PERCENT=3500
