# Azbit severe-dislocation profile. This never creates buy exposure and keeps
# any eventual sell-side canary deliberately small.
EXCHANGE_NAME=azbit
TRADING_PAIR=EPWX_USDT
AZBIT_READ_ONLY=true

FORCE_BUY_PAUSE=true
BUY_REACTIVATION_MODE=off
SELF_TRADE_ENABLED=false
SELF_TRADE_MODE=off

MIN_ORDER_SIZE=0.75
MAX_ORDER_SIZE=0.80
MAX_ORDER_AMOUNT_TOKENS=3000000000
TARGET_ORDERS_PER_SIDE=1
TARGET_BUY_DEPTH_USD=0
TARGET_SELL_DEPTH_USD=0.80
ORDER_FREQUENCY=60000
QUOTE_CHURN_REFRESH_PER_SIDE=1
BALANCE_UTILIZATION_PERCENT=0.05
IDLE_BALANCE_RESERVE_USD=48

MAX_EXEC_SPREAD_PERCENT=600
MAX_EXECUTABLE_SPREAD_CIRCUIT_BREAKER_PERCENT=650
MIN_EXEC_DEPTH_BUY_USD=0.5
MIN_EXEC_DEPTH_SELL_USD=0.5
MIN_NET_EDGE_BPS=50
ADVERSE_FILL_RATIO_MAX=1.05
ADVERSE_FILL_INVENTORY_LIMIT_USD=1
RISK_SIZE_MULTIPLIER_DEFENSIVE=0.20
RISK_SIZE_MULTIPLIER_NORMAL=0.25
REBALANCE_MAX_SPREAD_PERCENT=8
REBALANCE_MAX_PRICE_DEVIATION_PERCENT=5

INVENTORY_SKEW_MAX_PERCENT=0.0005
INVENTORY_SKEW_ACTIVATION_RATIO=0.02
MAX_POSITION_SIZE=10000000000
POSITION_REBALANCE_THRESHOLD=5000000000
PASSIVE_BUY_BAND_OUTER_OFFSET_PERCENT=0.01
PASSIVE_BUY_BAND_INNER_OFFSET_PERCENT=0.005
PASSIVE_SELL_BAND_INNER_OFFSET_PERCENT=0.004
PASSIVE_SELL_BAND_OUTER_OFFSET_PERCENT=0.01
PASSIVE_SEED_BASE_OFFSET_PERCENT=0.004
PASSIVE_SEED_STEP_OFFSET_PERCENT=0.0005
TOP_TOUCH_IMPROVEMENT_SPREAD_FRACTION=0
SELL_NEAR_BID_ENABLED=false

CANCEL_ORDERS_ON_START=false
CANCEL_ORDERS_ON_STOP=false

IDLE_WASH_ENABLE_AFTER_MS=31536000000
IDLE_WASH_COOLDOWN_AFTER_REAL_FILL_MS=31536000000
IDLE_WASH_MAX_PAIRS_PER_CYCLE=0
IDLE_WASH_REQUIRE_LOW_DRIFT=true
IDLE_WASH_MAX_DRIFT_PERCENT=0
IDLE_WASH_MAX_EXEC_SPREAD_PERCENT=0
PAUSE_WASH_ON_HIGH_DRIFT=true
WASH_RESERVED_PLACEMENTS_PER_CYCLE=0
WASH_ORDER_SIZE_CAP_USD=0
WASH_USDT_SCALE_THRESHOLD=999999
WASH_BASE_PAIRS_PER_CYCLE=0
WASH_MAX_PAIRS_PER_CYCLE=0
IDLE_WASH_SAME_PRICE_UPWARD_STEP_BPS_PER_MINUTE=0
IDLE_WASH_SAME_PRICE_UPWARD_MAX_BPS=0
IDLE_WASH_PROTECT_EXTERNAL_BUYS=true
IDLE_WASH_PROTECT_MIN_SPREAD_TICKS=100