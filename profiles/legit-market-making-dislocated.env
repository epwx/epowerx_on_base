# =========================================================
# LEGITIMATE MARKET MAKING - DISLOCATED MARKET PROFILE
# =========================================================
# Purpose:
# - Keep real user market-making active in stressed books.
# - Use wider spread and drift tolerance than normal profile.
# - Disable self-trade and wash behavior completely.
# =========================================================

# --- Core mode ---
BUY_REACTIVATION_MODE=auto
SELF_TRADE_ENABLED=false
SELF_TRADE_MODE=off

# --- Dislocation-tolerant guardrails ---
MAX_DEX_CEX_DRIFT_PERCENT=45
MAX_EXEC_SPREAD_PERCENT=600
MIN_EXEC_DEPTH_BUY_USD=5
MIN_EXEC_DEPTH_SELL_USD=5
MIN_NET_EDGE_BPS=14
ADVERSE_FILL_RATIO_MAX=1.30

# --- Inventory and pacing ---
IDLE_BALANCE_RESERVE_USD=300
TARGET_ORDERS_PER_SIDE=1
TARGET_BUY_DEPTH_USD=20
TARGET_SELL_DEPTH_USD=20
ORDER_FREQUENCY=15000

# --- Passive band and inventory skew controls ---
INVENTORY_SKEW_MAX_PERCENT=0.0015
INVENTORY_SKEW_ACTIVATION_RATIO=0.08
PASSIVE_BUY_BAND_OUTER_OFFSET_PERCENT=0.0040
PASSIVE_BUY_BAND_INNER_OFFSET_PERCENT=0.0008
PASSIVE_SELL_BAND_INNER_OFFSET_PERCENT=0.0008
PASSIVE_SELL_BAND_OUTER_OFFSET_PERCENT=0.0040
PASSIVE_SEED_BASE_OFFSET_PERCENT=0.0012
PASSIVE_SEED_STEP_OFFSET_PERCENT=0.0003

# --- Explicitly neutralize idle wash path ---
IDLE_WASH_ENABLE_AFTER_MS=31536000000
IDLE_WASH_COOLDOWN_AFTER_REAL_FILL_MS=31536000000
IDLE_WASH_MAX_PAIRS_PER_CYCLE=0
IDLE_WASH_REQUIRE_LOW_DRIFT=true
IDLE_WASH_MAX_DRIFT_PERCENT=3
IDLE_WASH_MAX_EXEC_SPREAD_PERCENT=8
PAUSE_WASH_ON_HIGH_DRIFT=true
WASH_RESERVED_PLACEMENTS_PER_CYCLE=0
WASH_ORDER_SIZE_CAP_USD=0
WASH_USDT_SCALE_THRESHOLD=999999
WASH_BASE_PAIRS_PER_CYCLE=0
WASH_MAX_PAIRS_PER_CYCLE=0
IDLE_WASH_SAME_PRICE_UPWARD_STEP_BPS_PER_MINUTE=0
IDLE_WASH_SAME_PRICE_UPWARD_MAX_BPS=0
IDLE_WASH_PROTECT_EXTERNAL_BUYS=true
IDLE_WASH_PROTECT_MIN_SPREAD_TICKS=30
