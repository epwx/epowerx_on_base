# =========================================================
# LEGITIMATE MARKET MAKING - SELL-ONLY RECOVERY PROFILE
# =========================================================
# Purpose:
# - Keep quoting active on sell side only during severe dislocation.
# - Avoid opening new buys while trying to tighten ask-side pressure.
# - Keep self-trade and idle wash disabled.
# =========================================================

# --- Core mode ---
BUY_REACTIVATION_MODE=off
FORCE_BUY_PAUSE=true
SELF_TRADE_ENABLED=false
SELF_TRADE_MODE=off

# --- ETH/USD source (Alchemy/RPC + Chainlink) ---
ETH_USD_SOURCE=chainlink
ETH_USD_CHAINLINK_FEED_ADDRESS=0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70
ETH_USD_FALLBACK=2200
ETH_USD_CACHE_MS=120000
COINGECKO_ETH_USD_URL=https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd

# --- Dislocation-tolerant guardrails ---
MAX_DEX_CEX_DRIFT_PERCENT=45
MAX_EXEC_SPREAD_PERCENT=600
MAX_EXECUTABLE_SPREAD_CIRCUIT_BREAKER_PERCENT=220
MIN_EXEC_DEPTH_BUY_USD=0
MIN_EXEC_DEPTH_SELL_USD=0
MIN_NET_EDGE_BPS=0
ADVERSE_FILL_RATIO_MAX=1.30

# --- Inventory and pacing ---
IDLE_BALANCE_RESERVE_USD=260
TARGET_ORDERS_PER_SIDE=3
TARGET_BUY_DEPTH_USD=0
TARGET_SELL_DEPTH_USD=6
ORDER_FREQUENCY=10000
QUOTE_CHURN_REFRESH_PER_SIDE=2
TOP_TOUCH_IMPROVEMENT_SPREAD_FRACTION=0.49
MAX_ORDER_AMOUNT_TOKENS=12000000000
SELL_NEAR_BID_ENABLED=true
SELL_NEAR_BID_TICKS=1
SELL_NEAR_BID_MIN_MARKUP_BPS=2

# Re-seed quotes on each deploy so new pricing logic takes effect immediately.
CANCEL_ORDERS_ON_START=true
CANCEL_ORDERS_ON_STOP=false

# --- Passive band and inventory skew controls ---
INVENTORY_SKEW_MAX_PERCENT=0.0015
INVENTORY_SKEW_ACTIVATION_RATIO=0.08
MAX_POSITION_SIZE=200000000000
POSITION_REBALANCE_THRESHOLD=200000000000
PASSIVE_BUY_BAND_OUTER_OFFSET_PERCENT=0.0040
PASSIVE_BUY_BAND_INNER_OFFSET_PERCENT=0.0008
PASSIVE_SELL_BAND_INNER_OFFSET_PERCENT=0.0002
PASSIVE_SELL_BAND_OUTER_OFFSET_PERCENT=0.0012
PASSIVE_SEED_BASE_OFFSET_PERCENT=0.0001
PASSIVE_SEED_STEP_OFFSET_PERCENT=0.00005

# --- Explicitly neutralize idle wash path ---
IDLE_WASH_ENABLE_AFTER_MS=31536000000
IDLE_WASH_COOLDOWN_AFTER_REAL_FILL_MS=31536000000
IDLE_WASH_MAX_PAIRS_PER_CYCLE=0
IDLE_WASH_REQUIRE_LOW_DRIFT=true
IDLE_WASH_MAX_DRIFT_PERCENT=3
IDLE_WASH_MAX_EXEC_SPREAD_PERCENT=8
PAUSE_WASH_ON_HIGH_DRIFT=true
WASH_RESERVED_PLACEMENTS_PER_CYCLE=0
WASH_ORDER_SIZE_CAP_USD=0
WASH_USDT_SCALE_THRESHOLD=999999
WASH_BASE_PAIRS_PER_CYCLE=0
WASH_MAX_PAIRS_PER_CYCLE=0
IDLE_WASH_SAME_PRICE_UPWARD_STEP_BPS_PER_MINUTE=0
IDLE_WASH_SAME_PRICE_UPWARD_MAX_BPS=0
IDLE_WASH_PROTECT_EXTERNAL_BUYS=true
IDLE_WASH_PROTECT_MIN_SPREAD_TICKS=30
