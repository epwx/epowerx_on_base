# =========================================================
# IDLE WASH MODE
# =========================================================
# Sell-only (no buys), but enables wash trading when market is quiet
# Wash starts after 15 minutes of no real fills
# Wash stops immediately when real user order fills
# Only washes if drift < 3% AND spread < 8%
# =========================================================

BUY_REACTIVATION_MODE=off
SELF_TRADE_MODE=auto
TARGET_ORDERS_PER_SIDE=1
TARGET_BUY_DEPTH_USD=0
TARGET_SELL_DEPTH_USD=15
ORDER_FREQUENCY=20000
IDLE_WASH_ENABLE_AFTER_MS=900000
IDLE_WASH_COOLDOWN_AFTER_REAL_FILL_MS=1800000
IDLE_WASH_MAX_PAIRS_PER_CYCLE=1
IDLE_WASH_REQUIRE_LOW_DRIFT=true
IDLE_WASH_MAX_DRIFT_PERCENT=3
IDLE_WASH_MAX_EXEC_SPREAD_PERCENT=8
PAUSE_WASH_ON_HIGH_DRIFT=true
