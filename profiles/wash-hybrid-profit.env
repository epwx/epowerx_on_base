# =========================================================
# WASH + REAL SPREAD HYBRID PROFILE
# =========================================================
# Strategy: Idea 4 - wash volume generation + real market-making.
# - Wash trades (SELF_TRADE_MODE=auto) run every cycle for volume.
# - Real buy/sell quotes layered on top to capture external spread.
# - Wash trades are zero-cost on zero-fee account.
# - Buys remain paused until adverse-fill guard clears naturally.
# =========================================================

# --- Core mode ---
FORCE_BUY_PAUSE=false
BUY_REACTIVATION_MODE=auto
DEX_PRICE_DISCOUNT_PERCENT=26
SELF_TRADE_ENABLED=true
SELF_TRADE_MODE=auto

# --- ETH/USD source ---
ETH_USD_SOURCE=chainlink
ETH_USD_CHAINLINK_FEED_ADDRESS=0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70
ETH_USD_FALLBACK=2200
ETH_USD_CACHE_MS=120000
COINGECKO_ETH_USD_URL=https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd

# --- Spread / drift guardrails ---
MAX_DEX_CEX_DRIFT_PERCENT=75
MAX_EXEC_SPREAD_PERCENT=600
MAX_EXECUTABLE_SPREAD_CIRCUIT_BREAKER_PERCENT=200
MIN_EXEC_DEPTH_BUY_USD=0
MIN_EXEC_DEPTH_SELL_USD=0
MIN_NET_EDGE_BPS=5

# Conservative ratio so buys only resume after sell fills reduce inventory.
ADVERSE_FILL_RATIO_MAX=2.0

# --- USDT budget: $620 reserved, ~$80 real + wash budget ---
IDLE_BALANCE_RESERVE_USD=620

# --- Real market-making: 3 orders per side ---
TARGET_ORDERS_PER_SIDE=3
TARGET_BUY_DEPTH_USD=16
TARGET_SELL_DEPTH_USD=16
MAX_ORDER_AMOUNT_TOKENS=50000000000

# Cycle pacing: fast enough for wash volume, not so fast it floods the book.
ORDER_FREQUENCY=7000
QUOTE_CHURN_REFRESH_PER_SIDE=1

# --- Spread band for real quotes ---
PASSIVE_BUY_BAND_OUTER_OFFSET_PERCENT=0.020
PASSIVE_BUY_BAND_INNER_OFFSET_PERCENT=0.002
PASSIVE_SELL_BAND_INNER_OFFSET_PERCENT=0.002
PASSIVE_SELL_BAND_OUTER_OFFSET_PERCENT=0.020
PASSIVE_SEED_BASE_OFFSET_PERCENT=0.004
PASSIVE_SEED_STEP_OFFSET_PERCENT=0.004
TOP_TOUCH_IMPROVEMENT_SPREAD_FRACTION=0.50
SELL_NEAR_BID_ENABLED=true
SELL_NEAR_BID_TICKS=1
SELL_NEAR_BID_MIN_MARKUP_BPS=2

# --- Inventory limits ---
INVENTORY_SKEW_MAX_PERCENT=0.002
INVENTORY_SKEW_ACTIVATION_RATIO=0.08
MAX_POSITION_SIZE=200000000000
POSITION_REBALANCE_THRESHOLD=150000000000

CANCEL_ORDERS_ON_START=true
CANCEL_ORDERS_ON_STOP=false

# --- Wash trading config ---
# 1 wash pair per cycle = ~$25 volume per 7s = ~$308k/day.
# Kicks in after 30s idle, pauses 60s after any real fill.
# Protected against accidentally filling real orders.
IDLE_WASH_ENABLE_AFTER_MS=30000
IDLE_WASH_COOLDOWN_AFTER_REAL_FILL_MS=60000
IDLE_WASH_MAX_PAIRS_PER_CYCLE=2
IDLE_WASH_REQUIRE_LOW_DRIFT=false
IDLE_WASH_MAX_DRIFT_PERCENT=75
IDLE_WASH_MAX_EXEC_SPREAD_PERCENT=600
PAUSE_WASH_ON_HIGH_DRIFT=false
WASH_RESERVED_PLACEMENTS_PER_CYCLE=2
WASH_ORDER_SIZE_CAP_USD=25
WASH_USDT_SCALE_THRESHOLD=50
WASH_BASE_PAIRS_PER_CYCLE=1
WASH_MAX_PAIRS_PER_CYCLE=2
IDLE_WASH_SAME_PRICE_UPWARD_STEP_BPS_PER_MINUTE=0
IDLE_WASH_SAME_PRICE_UPWARD_MAX_BPS=0
IDLE_WASH_PROTECT_EXTERNAL_BUYS=true
IDLE_WASH_PROTECT_MIN_SPREAD_TICKS=5
