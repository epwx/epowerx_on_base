# =========================================================
# REAL-SPREAD HYBRID PROFIT PROFILE
# =========================================================
# Legacy filename retained for deployment compatibility.
# - Quotes only for external users; self-trading is disabled.
# - Buys require acceptable spread, drift, depth, and net edge.
# - Small quote targets and strict imbalance controls bound inventory risk.
# =========================================================

# --- Core mode ---
FORCE_BUY_PAUSE=false
BUY_REACTIVATION_MODE=auto
DEX_PRICE_DISCOUNT_PERCENT=26
SELF_TRADE_ENABLED=false
SELF_TRADE_MODE=off

# --- ETH/USD source ---
ETH_USD_SOURCE=chainlink
ETH_USD_CHAINLINK_FEED_ADDRESS=0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70
ETH_USD_FALLBACK=2200
ETH_USD_CACHE_MS=120000
COINGECKO_ETH_USD_URL=https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd

# --- Spread / drift guardrails ---
MAX_DEX_CEX_DRIFT_PERCENT=4
MAX_EXEC_SPREAD_PERCENT=8
MAX_EXECUTABLE_SPREAD_CIRCUIT_BREAKER_PERCENT=8
MIN_EXEC_DEPTH_BUY_USD=10
MIN_EXEC_DEPTH_SELL_USD=10
MIN_NET_EDGE_BPS=150
RISK_SIZE_MULTIPLIER_DEFENSIVE=0.25
RISK_SIZE_MULTIPLIER_NORMAL=0.40

# Stop buying when external BUY fills outpace SELL fills or long inventory reaches $6.
ADVERSE_FILL_RATIO_MAX=1.10
ADVERSE_FILL_INVENTORY_LIMIT_USD=6

# --- USDT budget: preserve the $620 reserve used during the trial ---
IDLE_BALANCE_RESERVE_USD=620

# --- Small real-user trial: one quote per side ---
TARGET_ORDERS_PER_SIDE=1
TARGET_BUY_DEPTH_USD=5.25
TARGET_SELL_DEPTH_USD=5.75
MIN_ORDER_SIZE=5.25
MAX_ORDER_SIZE=6
MAX_ORDER_AMOUNT_TOKENS=50000000000
BALANCE_UTILIZATION_PERCENT=0.25

# Slow refresh avoids repeatedly chasing a thin book.
ORDER_FREQUENCY=15000
QUOTE_CHURN_REFRESH_PER_SIDE=1

# --- Spread band for real quotes ---
PASSIVE_BUY_BAND_OUTER_OFFSET_PERCENT=0.008
PASSIVE_BUY_BAND_INNER_OFFSET_PERCENT=0.003
PASSIVE_SELL_BAND_INNER_OFFSET_PERCENT=0.003
PASSIVE_SELL_BAND_OUTER_OFFSET_PERCENT=0.008
PASSIVE_SEED_BASE_OFFSET_PERCENT=0.004
PASSIVE_SEED_STEP_OFFSET_PERCENT=0.001
TOP_TOUCH_IMPROVEMENT_SPREAD_FRACTION=0
SELL_NEAR_BID_ENABLED=false
SELL_NEAR_BID_TICKS=1
SELL_NEAR_BID_MIN_MARKUP_BPS=150

# --- Inventory limits ---
INVENTORY_SKEW_MAX_PERCENT=0.004
INVENTORY_SKEW_ACTIVATION_RATIO=0.05
MAX_POSITION_SIZE=50000000000
POSITION_REBALANCE_THRESHOLD=40000000000
REBALANCE_COOLDOWN_MS=60000
REBALANCE_MAX_SPREAD_PERCENT=5
REBALANCE_MAX_PRICE_DEVIATION_PERCENT=3

CANCEL_ORDERS_ON_START=true
CANCEL_ORDERS_ON_STOP=false

# --- Self-trading explicitly disabled ---
IDLE_WASH_ENABLE_AFTER_MS=31536000000
IDLE_WASH_COOLDOWN_AFTER_REAL_FILL_MS=31536000000
IDLE_WASH_MAX_PAIRS_PER_CYCLE=0
IDLE_WASH_REQUIRE_LOW_DRIFT=true
IDLE_WASH_MAX_DRIFT_PERCENT=3
IDLE_WASH_MAX_EXEC_SPREAD_PERCENT=5
PAUSE_WASH_ON_HIGH_DRIFT=true
WASH_RESERVED_PLACEMENTS_PER_CYCLE=0
WASH_ORDER_SIZE_CAP_USD=0
WASH_USDT_SCALE_THRESHOLD=999999
WASH_BASE_PAIRS_PER_CYCLE=0
WASH_MAX_PAIRS_PER_CYCLE=0
IDLE_WASH_SAME_PRICE_UPWARD_STEP_BPS_PER_MINUTE=0
IDLE_WASH_SAME_PRICE_UPWARD_MAX_BPS=0
IDLE_WASH_PROTECT_EXTERNAL_BUYS=true
IDLE_WASH_PROTECT_MIN_SPREAD_TICKS=30
